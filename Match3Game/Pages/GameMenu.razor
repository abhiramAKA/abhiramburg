@page "/"
@using Match3Game.Pages

<!-- Информационный блок №1 (Всегда сверху) -->
<div class="info-block-1">
    <h3>📊 Информационный блок №1</h3>
    <p>Всего сыграно игр 3-в-ряд: <strong>@TotalGamesPlayed</strong></p>
</div>

@if (currentScreen == ScreenState.TownSquare)
{
    <!-- ЭКРАН 1: ЦЕНТРАЛЬНАЯ ПЛОЩАДЬ -->
    <div class="menu-container">
        <h1 class="screen-title">Центральная площадь</h1>

        <div class="buttons-grid">
            <!-- Активная кнопка -->
            <button class="menu-btn active-btn" @onclick="GoToValleyOfLight">
                🌅 Долина света
            </button>

            <!-- Неактивные кнопки с замочками -->
            <button class="menu-btn locked-btn" @onclick="ShowSoonAlert">
                🔒 Таверна
            </button>
            <button class="menu-btn locked-btn" @onclick="ShowSoonAlert">
                🔒 Шахты
            </button>
            <button class="menu-btn locked-btn" @onclick="ShowSoonAlert">
                🔒 Мастерская
            </button>
            <button class="menu-btn locked-btn" @onclick="ShowSoonAlert">
                🔒 Ярмарка
            </button>
            <button class="menu-btn locked-btn" @onclick="ShowSoonAlert">
                🔒 Дракон
            </button>
        </div>
    </div>
}
else if (currentScreen == ScreenState.ValleyOfLight)
{
    <!-- ЭКРАН 2: ДОЛИНА СВЕТА -->
    <div class="menu-container">
        <h1 class="screen-title">🌅 Долина света</h1>

        <div class="buttons-grid">
            <!-- Активная кнопка -->
            <button class="menu-btn play-btn" @onclick="StartGame">
                🎮 Играть
            </button>

            <!-- Неактивные кнопки -->
            <button class="menu-btn locked-btn" @onclick="ShowSoonAlert">
                🔒 Позвать друга
            </button>
            <button class="menu-btn locked-btn" @onclick="ShowSoonAlert">
                🔒 Лидеры
            </button>

            <!-- Кнопка Назад на площадь -->
            <button class="menu-btn back-btn" @onclick="GoToTownSquare">
                ⬅️ Назад в город
            </button>
        </div>
    </div>
}
else if (currentScreen == ScreenState.InGame)
{
    <!-- ЭКРАН 3: ИГРА 3 В РЯД -->
    <Match3 OnGameOver="HandleGameOver" />
}

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="custom-alert">
        <div class="alert-content">
            <p>@alertMessage</p>
            <button class="close-alert-btn" @onclick="CloseAlert">OK</button>
        </div>
    </div>
}

@code {
    private enum ScreenState { TownSquare, ValleyOfLight, InGame }
    private ScreenState currentScreen = ScreenState.TownSquare;
    private string alertMessage = "";
    
    // Статическое свойство для сквозного подсчета игр во время сессии
    public static int TotalGamesPlayed { get; set; } = 0;

    private void GoToValleyOfLight() => currentScreen = ScreenState.ValleyOfLight;
    private void GoToTownSquare() => currentScreen = ScreenState.TownSquare;
    private void StartGame() => currentScreen = ScreenState.InGame;

    private void ShowSoonAlert()
    {
        alertMessage = "Скоро";
    }

    private void CloseAlert()
    {
        alertMessage = "";
    }

    private void HandleGameOver()
    {
        // Увеличиваем счетчик сыгранных игр при выходе/завершении игры
        TotalGamesPlayed++;
        // Возвращаемся в меню Долины Света
        currentScreen = ScreenState.ValleyOfLight;
        StateHasChanged();
    }
}

<style>
    .info-block-1 {
        background: linear-gradient(135deg, #2c3e50, #34495e);
        color: #fff;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 20px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        border: 2px solid #4a6572;
    }
    .info-block-1 h3 { margin: 0 0 5px 0; font-size: 1.1rem; color: #f1c40f; }
    .info-block-1 p { margin: 0; font-size: 1rem; }

    .menu-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 10px;
    }
    .screen-title {
        color: #fff;
        font-size: 1.6rem;
        margin-bottom: 25px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        text-align: center;
    }
    .buttons-grid {
        display: flex;
        flex-direction: column;
        gap: 15px;
        width: 100%;
        max-width: 300px;
    }
    .menu-btn {
        padding: 14px 20px;
        font-size: 1.1rem;
        font-weight: bold;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: transform 0.1s, filter 0.2s;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        text-align: center;
    }
    .menu-btn:active { transform: scale(0.97); }
    
    .active-btn { background: #3498db; color: white; }
    .play-btn { background: #2ecc71; color: white; }
    .back-btn { background: #95a5a6; color: white; margin-top: 10px; }
    
    .locked-btn { 
        background: #7f8c8d; 
        color: #bdc3c7; 
        filter: grayscale(0.6);
        position: relative;
    }

    /* Кастомное модальное окно для сообщения "Скоро" */
    .custom-alert {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }
    .alert-content {
        background: #2c3e50;
        color: white;
        padding: 25px 40px;
        border-radius: 15px;
        text-align: center;
        border: 2px solid #f1c40f;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    .alert-content p { font-size: 1.3rem; margin-0 0 20px 0; font-weight: bold; }
    .close-alert-btn {
        background: #f1c40f;
        color: #2c3e50;
        border: none;
        padding: 8px 25px;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 5px;
        cursor: pointer;
    }
</style>
