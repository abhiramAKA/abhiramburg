@page "/"
@using Match3Game.Pages

@if (currentScreen == ScreenState.TownSquare || currentScreen == ScreenState.ValleyOfLight || currentScreen == ScreenState.ProfileMenu)
{
    <div class="info-block-1" style="background: linear-gradient(135deg, #2c3e50, #34495e); color: #fff; padding: 15px; border-radius: 12px; margin-bottom: 20px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.2); border: 2px solid #4a6572;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <button style="background: #34495e; border: 1px solid #4a6572; color: white; font-size: 1.1rem; padding: 4px 8px; border-radius: 6px; cursor: pointer;" @onclick="OpenHistoryModal">👤</button>
                <h3 style="margin: 0; font-size: 1.1rem; color: #f1c40f;">Аккаунт: @(isRegistered ? userName : "Гость")</h3>
            </div>
            <button style="background: #f1c40f; color: #2c3e50; border: none; padding: 4px 12px; border-radius: 6px; font-weight: bold; font-size: 0.85rem; cursor: pointer;" @onclick="ToggleProfile">
                @(currentScreen == ScreenState.ProfileMenu ? "⬅️ В город" : "⚙️ Профиль")
            </button>
        </div>
        @if (isRegistered && !string.IsNullOrEmpty(walletAddress))
        {
            <p style="font-size: 0.85rem; color: #bdc3c7; margin: 0 0 5px 0; text-align: left; padding-left: 32px;">💳 Кошелек: @ShortenWallet(walletAddress)</p>
        }
        <p style="margin: 0; font-size: 1rem; text-align: left; padding-left: 32px;">Всего сыграно игр 3-в-ряд: <strong>@gameHistory.Count</strong></p>
    </div>
}

@if (currentScreen == ScreenState.TownSquare)
{
    <div style="display: flex; flex-direction: column; align-items: center; padding: 10px;">
        <h1 style="color: #fff; font-size: 1.6rem; margin-bottom: 25px; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">Центральная площадь</h1>
        <div style="display: flex; flex-direction: column; gap: 15px; width: 100%; max-width: 300px;">
            <button style="background: #3498db; color: white; padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px; cursor: pointer;" @onclick="GoToValleyOfLight">🌅 Долина света</button>
            <button style="background: #7f8c8d; color: #bdc3c7; filter: grayscale(0.6); padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px;" @onclick="ShowSoonAlert">🔒 Таверна</button>
            <button style="background: #7f8c8d; color: #bdc3c7; filter: grayscale(0.6); padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px;" @onclick="ShowSoonAlert">🔒 Шахты</button>
            <button style="background: #7f8c8d; color: #bdc3c7; filter: grayscale(0.6); padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px;" @onclick="ShowSoonAlert">🔒 Мастерская</button>
            <button style="background: #7f8c8d; color: #bdc3c7; filter: grayscale(0.6); padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px;" @onclick="ShowSoonAlert">🔒 Ярмарка</button>
            <button style="background: #7f8c8d; color: #bdc3c7; filter: grayscale(0.6); padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px;" @onclick="ShowSoonAlert">🔒 Дракон</button>
        </div>
    </div>
}
else if (currentScreen == ScreenState.ValleyOfLight)
{
    <div style="display: flex; flex-direction: column; align-items: center; padding: 10px;">
        <h1 style="color: #fff; font-size: 1.6rem; margin-bottom: 25px; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">🌅 Долина света</h1>
        <div style="display: flex; flex-direction: column; gap: 15px; width: 100%; max-width: 300px;">
            <button style="background: #2ecc71; color: white; padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px; cursor: pointer;" @onclick="StartGame">🎮 Играть</button>
            <button style="background: #7f8c8d; color: #bdc3c7; filter: grayscale(0.6); padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px;" @onclick="ShowSoonAlert">🔒 Позвать друга</button>
            <button style="background: #7f8c8d; color: #bdc3c7; filter: grayscale(0.6); padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px;" @onclick="ShowSoonAlert">🔒 Лидеры</button>
            <button style="background: #95a5a6; color: white; padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px; cursor: pointer; margin-top: 10px;" @onclick="GoToTownSquare">⬅️ Назад в город</button>
        </div>
    </div>
}
else if (currentScreen == ScreenState.ProfileMenu)
{
    <div style="display: flex; flex-direction: column; align-items: center; padding: 10px;">
        <h1 style="color: #fff; font-size: 1.6rem; margin-bottom: 25px; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">👤 Регистрация</h1>
        <div style="background: #2c3e50; border: 2px solid #34495e; border-radius: 12px; padding: 20px; width: 100%; max-width: 300px; display: flex; flex-direction: column; gap: 15px;">
            <div style="display: flex; flex-direction: column; gap: 5px;">
                <label style="font-size: 0.9rem; color: #f1c40f; font-weight: bold;">Имя игрока:</label>
                <input type="text" @bind="inputName" placeholder="Придумайте имя..." maxlength="20" style="padding: 10px; border-radius: 6px; border: 1px solid #4a6572; background: #1a1a1a; color: white;" />
            </div>
            <div style="display: flex; flex-direction: column; gap: 5px;">
                <label style="font-size: 0.9rem; color: #f1c40f; font-weight: bold;">Криптокошелек Грам:</label>
                <input type="text" @bind="inputWallet" placeholder="Адрес кошелька..." style="padding: 10px; border-radius: 6px; border: 1px solid #4a6572; background: #1a1a1a; color: white;" />
            </div>
            <button style="background: #2ecc71; color: white; padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px; cursor: pointer;" @onclick="SaveProfile">💾 Сохранить аккаунт</button>
        </div>
    </div>
}
else if (currentScreen == ScreenState.InGame)
{
    <Match3 IsWalletConnected="@isRegistered" OnGameOverWithScore="HandleGameOver" OnRequestAuth="HandleRequestAuth" />
}


@if (showHistoryModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <div style="background: #2c3e50; color: white; padding: 25px; border-radius: 15px; text-align: center; border: 2px solid #f1c40f; max-width: 320px; width: 90%; max-height: 80vh; overflow-y: auto;">
            <h3 style="color: #f1c40f; margin-top: 0;">📜 История всех игр</h3>
            @if (gameHistory.Count == 0)
            {
                <p style="color: #bdc3c7;">Вы еще не сыграли ни одной игры.</p>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; text-align: left;">
                    @for (int i = 0; i < gameHistory.Count; i++)
                    {
                        <div style="background: rgba(0,0,0,0.2); padding: 8px 12px; border-radius: 6px; border-left: 4px solid #2ecc71; display: flex; justify-content: space-between;">
                            <span>Игра #@(i + 1)</span>
                            <span style="font-weight: bold; color: #f1c40f;">🏆 @gameHistory[i] очков</span>
                        </div>
                    }
                </div>
            }
            <button style="background: #f1c40f; color: #2c3e50; border: none; padding: 8px 25px; font-weight: bold; border-radius: 5px; cursor: pointer;" @onclick="CloseHistoryModal">Закрыть</button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <div style="background: #2c3e50; color: white; padding: 25px 40px; border-radius: 15px; text-align: center; border: 2px solid #f1c40f;">
            <p style="font-size: 1.3rem; margin: 0 0 20px 0; font-weight: bold;">@alertMessage</p>
            <button style="background: #f1c40f; color: #2c3e50; border: none; padding: 8px 25px; font-weight: bold; border-radius: 5px; cursor: pointer;" @onclick="CloseAlert">OK</button>
        </div>
    </div>
}

@code {
    private enum ScreenState { TownSquare, ValleyOfLight, InGame, ProfileMenu }
    private ScreenState currentScreen = ScreenState.TownSquare;
    private ScreenState previousScreen = ScreenState.TownSquare;
    private string alertMessage = "";
    private bool showHistoryModal = false;
    
    private bool isRegistered = false;
    private string userName = "Гость";
    private string walletAddress = "";

    private string inputName = "";
    private string inputWallet = "";

    private List<int> gameHistory = new List<int>();

    private void GoToValleyOfLight() => currentScreen = ScreenState.ValleyOfLight;
    private void GoToTownSquare() => currentScreen = ScreenState.TownSquare;
    private void StartGame() => currentScreen = ScreenState.InGame;

    private void ToggleProfile()
    {
        if (currentScreen == ScreenState.ProfileMenu) currentScreen = previousScreen;
        else { previousScreen = currentScreen; inputName = isRegistered ? userName : ""; inputWallet = isRegistered ? walletAddress : ""; currentScreen = ScreenState.ProfileMenu; }
    }

    private void SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(inputName) || string.IsNullOrWhiteSpace(inputWallet)) { alertMessage = "Заполните все поля!"; return; }
        userName = inputName.Trim(); walletAddress = inputWallet.Trim(); isRegistered = true;
        alertMessage = "Аккаунт сохранен!"; currentScreen = ScreenState.TownSquare;
    }

    private void HandleRequestAuth()
    {
        previousScreen = ScreenState.ValleyOfLight; inputName = ""; inputWallet = ""; currentScreen = ScreenState.ProfileMenu; StateHasChanged();
    }

    private void HandleGameOver(int finalScore)
    {
        gameHistory.Add(finalScore); currentScreen = ScreenState.ValleyOfLight; StateHasChanged();
    }

    private void OpenHistoryModal() => showHistoryModal = true;
    private void CloseHistoryModal() => showHistoryModal = false;
    private string ShortenWallet(string addr) => addr.Length <= 10 ? addr : addr.Substring(0, 6) + "..." + addr.Substring(addr.Length - 4);
    private void ShowSoonAlert() => alertMessage = "Скоро";
    private void CloseAlert() => alertMessage = "";
}
