@page "/"
@using Match3Game.Pages
@using Match3Game.Core
@inject IJSRuntime JS

@if (currentScreen != ScreenState.InGame)
{
    <div class="info-block-1" style="background: linear-gradient(135deg, #2c3e50, #34495e); color: #fff; padding: 15px; border-radius: 12px; margin-bottom: 20px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.2); border: 2px solid #4a6572;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <button style="background: #34495e; border: 1px solid #4a6572; color: white; font-size: 1.1rem; padding: 4px 8px; border-radius: 6px; cursor: pointer;" @onclick="() => showHistory = true">👤</button>
                <h3 style="margin: 0; font-size: 1.1rem; color: #f1c40f;">Аккаунт: @(isRegistered ? userName : "Гость")</h3>
            </div>
            <button style="background: #f1c40f; color: #2c3e50; border: none; padding: 4px 12px; border-radius: 6px; font-weight: bold; font-size: 0.85rem; cursor: pointer;" @onclick="ToggleProfile">
                @((currentScreen == ScreenState.ProfileMenu) ? "⬅️ В город" : "⚙️ Профиль")
            </button>
        </div>
        @if (isRegistered && !string.IsNullOrEmpty(walletAddress))
        {
            <p style="font-size: 0.85rem; color: #bdc3c7; margin: 0 0 5px 0; text-align: left; padding-left: 32px;">💳 Кошелек: @ShortenWallet(walletAddress)</p>
        }
        <p style="margin: 0; font-size: 1rem; text-align: left; padding-left: 32px;">Всего сыграно игр 3-в-ряд: <strong>@GameHistoryService.GetTotalGames()</strong></p>
    </div>
}

@if (currentScreen == ScreenState.TownSquare)
{
    <TownSquareView OnGoToValley="() => currentScreen = ScreenState.ValleyOfLight" OnShowSoon="ShowSoonAlert" />
}
else if (currentScreen == ScreenState.ValleyOfLight)
{
    <ValleyOfLightView OnStartGame="() => currentScreen = ScreenState.InGame" OnGoToTown="() => currentScreen = ScreenState.TownSquare" OnShowSoon="ShowSoonAlert" />
}
else if (currentScreen == ScreenState.ProfileMenu)
{
    <div style="display: flex; flex-direction: column; align-items: center; padding: 10px;">
        <h1 style="color: #fff; font-size: 1.6rem; margin-bottom: 25px; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">👤 Регистрация</h1>
        <div style="background: #2c3e50; border: 2px solid #34495e; border-radius: 12px; padding: 20px; width: 100%; max-width: 300px; display: flex; flex-direction: column; gap: 15px;">
            <div style="display: flex; flex-direction: column; gap: 5px;">
                <label style="font-size: 0.9rem; color: #f1c40f; font-weight: bold;">Имя игрока:</label>
                <input type="text" @bind="inputName" placeholder="Придумайте имя..." maxlength="20" style="padding: 10px; border-radius: 6px; border: 1px solid #4a6572; background: #1a1a1a; color: white;" />
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 5px; margin-top: 5px;">
                <label style="font-size: 0.9rem; color: #bdc3c7; font-weight: bold;">Авторизация через блокчейн TON:</label>
                @if (!isRegistered)
                {
                    <button style="background: #3498db; color: white; padding: 12px; font-weight: bold; border: none; border-radius: 8px; cursor: pointer;" @onclick="ConnectViaTon">
                        💎 Подключить кошелек TON
                    </button>
                }
                else
                {
                    <div style="background: #27ae60; padding: 10px; border-radius: 6px; font-size: 0.9rem; font-weight: bold; text-align: center;">✅ Кошелек привязан!</div>
                    <button style="background: #c0392b; color: white; padding: 6px; font-size: 0.8rem; border: none; border-radius: 4px; cursor: pointer; margin-top: 5px;" @onclick="DisconnectTon">Отключить кошелек</button>
                }
            </div>
            <button style="background: #2ecc71; color: white; padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px; cursor: pointer; margin-top: 10px;" @onclick="SaveProfile">💾 Завершить настройку</button>
        </div>
    </div>
}
else if (currentScreen == ScreenState.InGame)
{
    <Match3 IsWalletConnected="@isRegistered" OnGameOver="() => currentScreen = ScreenState.ValleyOfLight" OnRequestAuth="HandleRequestAuth" />
}

<HistoryModal IsOpen="@showHistory" OnClose="() => showHistory = false" />

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <div style="background: #2c3e50; color: white; padding: 25px 40px; border-radius: 15px; text-align: center; border: 2px solid #f1c40f;">
            <p style="font-size: 1.3rem; margin: 0 0 20px 0; font-weight: bold;">@alertMessage</p>
            <button style="background: #f1c40f; color: #2c3e50; border: none; padding: 8px 25px; font-weight: bold; border-radius: 5px; cursor: pointer;" @onclick="() => alertMessage = null">OK</button>
        </div>
    </div>
}

@code {
    private enum ScreenState { TownSquare, ValleyOfLight, InGame, ProfileMenu }
    private ScreenState currentScreen = ScreenState.TownSquare;
    private ScreenState previousScreen = ScreenState.TownSquare;
    private string? alertMessage;
    private bool showHistory = false;
    private bool isRegistered = false;
    private string userName = "Гость";
    private string walletAddress = "";
    private string inputName = "";

    private DotNetObjectReference<object>? objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create<object>(this);
            await JS.InvokeVoidAsync("initTonConnect", objRef);
        }
    }

    private void ToggleProfile()
    {
        if (currentScreen == ScreenState.ProfileMenu) currentScreen = previousScreen;
        else { previousScreen = currentScreen; inputName = isRegistered ? userName : ""; currentScreen = ScreenState.ProfileMenu; }
    }

    private async Task ConnectViaTon() => await JS.InvokeVoidAsync("openTonConnectModal");
    private async Task DisconnectTon() => await JS.InvokeVoidAsync("disconnectTonWallet");

    [JSInvokable]
    public void OnWalletConnected(string realAddress)
    {
        walletAddress = realAddress;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnWalletDisconnected()
    {
        walletAddress = ""; isRegistered = false; userName = "Гость";
        StateHasChanged();
    }

    private void SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(inputName)) { alertMessage = "Пожалуйста, укажите имя!"; return; }
        if (string.IsNullOrEmpty(walletAddress)) { alertMessage = "Сначала необходимо подключить TON кошелек!"; return; }
        userName = inputName.Trim(); isRegistered = true;
        alertMessage = "Аккаунт успешно сохранен!"; currentScreen = ScreenState.TownSquare;
    }

    private void HandleRequestAuth()
    {
        previousScreen = ScreenState.ValleyOfLight; inputName = ""; currentScreen = ScreenState.ProfileMenu; StateHasChanged();
    }

    private string ShortenWallet(string addr) => addr.Length <= 10 ? addr : addr.Substring(0, 6) + "..." + addr.Substring(addr.Length - 4);
    private void ShowSoonAlert() => alertMessage = "Скоро";

    public void Dispose() => objRef?.Dispose();
}
