<div class="menu-screen">
    <h1 class="menu-title">💥 MATCH-3 💥</h1>
    
    <!-- Подключаем авторизацию обратно -->
    <TelegramAuth Username="@TelegramUser" OnUserAuthenticated="HandleAuth" />

    <p class="menu-desc">
        Собери как можно больше комбинаций!<br>
        У тебя есть ровно @MaxMoves ходов.
    </p>
    
    <button class="start-btn" @onclick="OnStartClick">Начать игру</button>
</div>

@code {
    [Parameter] public int MaxMoves { get; set; } = 25;
    [Parameter] public EventCallback OnStartGame { get; set; }
    
    private string? TelegramUser { get; set; }

    private void HandleAuth(string username)
    {
        TelegramUser = username;
        StateHasChanged();
    }

    private async Task OnStartClick()
    {
        if (OnStartGame.HasDelegate)
        {
            await OnStartGame.InvokeAsync();
        }
    }
}
