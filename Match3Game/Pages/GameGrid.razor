@code {
    [Parameter] public int Rows { get; set; }
    [Parameter] public int Cols { get; set; }
    [Parameter] public int[,] Grid { get; set; } = new int[0,0];
    [Parameter] public int SelectedRow { get; set; }
    [Parameter] public int SelectedCol { get; set; }
    [Parameter] public EventCallback<(int r, int c)> OnCellClick { get; set; }

    private string GetTileEmoji(int id) => id switch { 1 => "💎", 2 => "🔷", 3 => "💚", 4 => "🔶", 5 => "🔮", _ => "" };
}

<div style="display: grid; grid-template-columns: repeat(@Cols, 1fr); grid-template-rows: repeat(@Rows, 1fr); gap: 4px; background-color: #2c3e50; padding: 6px; border-radius: 12px; width: 100%; aspect-ratio: 1 / 1; box-shadow: 0 8px 20px rgba(0,0,0,0.5); box-sizing: border-box;">
    @for (int r = 0; r < Rows; r++)
    {
        @for (int c = 0; c < Cols; c++)
        {
            var row = r; var col = c;
            var tileId = Grid[row, col];
            var isSelected = (SelectedRow == row && SelectedCol == col);
            
            <div style="background-color: #34495e; border-radius: 6px; display: flex; align-items: center; justify-content: center; cursor: pointer; aspect-ratio: 1 / 1;" 
                 @onclick="() => OnCellClick.InvokeAsync((row, col))">
                @if (tileId > 0)
                {
                    <div style="font-size: 2rem; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; transition: transform 0.1s ease; @(isSelected ? "transform: scale(0.9); box-shadow: inset 0 0 0 3px #f1c40f; border-radius: 6px; background-color: rgba(241, 196, 15, 0.2);" : "")">
                        @GetTileEmoji(tileId)
                    </div>
                }
            </div>
        }
    }
</div>
