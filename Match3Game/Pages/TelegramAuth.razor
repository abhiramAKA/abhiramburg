@inject Microsoft.JSInterop.IJSRuntime JS

<div class="auth-container">
    @if (string.IsNullOrEmpty(Username))
    {
        <p class="auth-status">Войдите, чтобы сохранить свой результат:</p>
        <div id="telegram-auth-box" style="min-height: 40px; display: flex; justify-content: center; align-items: center;">
            <span style="font-size: 12px; color: #555;">Инициализация виджета...</span>
        </div>
    }
    else
    {
        <div class="user-badge">
            <span class="user-avatar">👤</span>
            <span class="user-name">Привет, @Username!</span>
        </div>
    }
</div>

@code {
    [Parameter] public string? Username { get; set; }
    [Parameter] public EventCallback<string> OnUserAuthenticated { get; set; }

    private static TelegramAuth? _instance;

    protected override void OnInitialized()
    {
        _instance = this;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && string.IsNullOrEmpty(Username))
        {
            await Task.Delay(200);
            try
            {
                await JS.InvokeVoidAsync("renderTelegramButton");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка отрисовки кнопки Telegram: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public static async Task ReceiveTelegramUser(string username)
    {
        if (_instance != null && _instance.OnUserAuthenticated.HasDelegate)
        {
            await _instance.OnUserAuthenticated.InvokeAsync(username);
        }
    }
}
