@inject Microsoft.JSInterop.IJSRuntime JS

<div class="auth-container">
    @if (string.IsNullOrEmpty(Username))
    {
        <p class="auth-status">Войдите, чтобы сохранить свой результат:</p>
        <!-- Сюда мгновенно и безопасно перенесется кнопка Telegram -->
        <div id="telegram-login-container"></div>
    }
    else
    {
        <div class="user-badge">
            <span class="user-avatar">👤</span>
            <span class="user-name">Привет, @Username!</span>
        </div>
    }
</div>

@code {
    [Parameter] public string? Username { get; set; }
    [Parameter] public EventCallback<string> OnUserAuthenticated { get; set; }

    private static TelegramAuth? _currentInstance;

    protected override void OnInitialized()
    {
        _currentInstance = this;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && string.IsNullOrEmpty(Username))
        {
            // Небольшая пауза, чтобы структура меню отрисовалась
            await Task.Delay(50);
            
            // Запускаем простую команду перемещения готовой кнопки из index.html в наше меню
            await JS.InvokeVoidAsync("eval", @"
                var template = document.getElementById('telegram-widget-template');
                var container = document.getElementById('telegram-login-container');
                if (template && container) {
                    container.appendChild(template);
                    template.style.display = 'block';
                }
            ");
        }
    }

    // Системный метод-мост для приема данных авторизации
    [JSInvokable]
    public static async Task ReceiveTelegramUser(string username)
    {
        if (_currentInstance != null && _currentInstance.OnUserAuthenticated.HasDelegate)
        {
            await _currentInstance.OnUserAuthenticated.InvokeAsync(username);
        }
    }
}
