@page "/"
@using Match3Game.Core
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="game-container">
    <div class="score-board">Очки: <span class="score-value">@_model.Score</span></div>
    
    <div class="button-container">
        <button class="game-btn" @onclick="MixBoard">Перемешать</button>
        <button class="game-btn music-btn" @onclick="ToggleMusic">🎵 Музыка</button>
    </div>

    <div class="game-board" style="grid-template-rows: repeat(@GameConfig.Rows, 1fr); grid-template-columns: repeat(@GameConfig.Cols, 1fr);">
        @for (int r = 0; r < GameConfig.Rows; r++)
        {
            for (int c = 0; c < GameConfig.Cols; c++)
            {
                int row = r;
                int col = c;
                int tileType = _model.Grid[row, col];
                bool isSelected = _selectedRow == row && _selectedCol == col;

                <div @key="@($"tile-{row}-{col}")" 
                     class="tile @(isSelected ? "selected" : "")" 
                     @onclick="() => OnTileClick(row, col)">
                    <span class="tile-content">@GetTileEmoji(tileType)</span>
                </div>
            }
        }
    </div>
</div>

@code {
    private GameModel _model = new();
    private int? _selectedRow;
    private int? _selectedCol;
    private bool _isProcessing;

    protected override void OnInitialized()
    {
        _model.InitGrid();
    }

    private void MixBoard()
    {
        _model.InitGrid();
        StateHasChanged();
    }

    private async Task ToggleMusic()
    {
        await JS.InvokeVoidAsync("audioEngine.toggleMusic");
    }

    private async Task OnTileClick(int row, int col)
    {
        if (_isProcessing) return;

        // При самом первом клике по полю даем команду запустить фоновую музыку
        await JS.InvokeVoidAsync("audioEngine.playMusic");

        if (_selectedRow == null || _selectedCol == null)
        {
            _selectedRow = row;
            _selectedCol = col;
            StateHasChanged();
        }
        else
        {
            var p1 = new TilePosition(_selectedRow.Value, _selectedCol.Value);
            var p2 = new TilePosition(row, col);

            _selectedRow = null;
            _selectedCol = null;

            if (_model.IsAdjacent(p1, p2))
            {
                _isProcessing = true;
                _model.Swap(p1, p2);
                StateHasChanged();
                await Task.Delay(250);
                
                var matches = _model.CheckMatches();

                if (matches.Count > 0)
                {
                    while (matches.Count > 0)
                    {
                        // Проигрываем звук взрыва при совпадении фишек
                        await JS.InvokeVoidAsync("audioEngine.playMatchSound");

                        _model.RemoveMatches(matches);
                        StateHasChanged();
                        await Task.Delay(250);

                        _model.DropTiles();
                        StateHasChanged();
                        await Task.Delay(250);

                        matches = _model.CheckMatches();
                    }
                }
                else
                {
                    _model.Swap(p1, p2);
                    StateHasChanged();
                }
                _isProcessing = false;
            }
            else
            {
                _selectedRow = row;
                _selectedCol = col;
                StateHasChanged();
            }
        }
    }

    private string GetTileEmoji(int type) => type switch
    {
        1 => "🔴", 2 => "🔵", 3 => "🟢", 4 => "🟡", 5 => "🟣", _ => ""
    };
}
