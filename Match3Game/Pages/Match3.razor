@page "/"
@using Match3Game.Core

<div class="game-container">
    <div class="score-board">Очки: <span class="score-value">@_model.Score</span></div>
    
    <button class="test-btn" @onclick="MixBoard">Перемешать поле</button>

    <div class="game-board" style="grid-template-rows: repeat(@GameConfig.Rows, 1fr); grid-template-columns: repeat(@GameConfig.Cols, 1fr);">
        @for (int r = 0; r < GameConfig.Rows; r++)
        {
            for (int c = 0; c < GameConfig.Cols; c++)
            {
                int row = r;
                int col = c;
                int tileType = _model.Grid[row, col];
                bool isSelected = _selectedRow == row && _selectedCol == col;
                
                // Анимация падения сработает только тогда, когда игра обрабатывает новые упавшие фишки
                bool isNewOrFalling = tileType != 0 && _isJustDropped; 

                <!-- @key гарантирует, что Blazor обновит только изменившиеся ячейки, убирая мигание -->
                <div @key="@($"tile-{row}-{col}-{tileType}")" 
                     class="tile @(isSelected ? "selected" : "") @(isNewOrFalling ? "falling" : "")" 
                     @onclick="() => OnTileClick(row, col)">
                    @GetTileEmoji(tileType)
                </div>
            }
        }
    </div>
</div>

@code {
    private GameModel _model = new();
    private int? _selectedRow;
    private int? _selectedCol;
    private bool _isProcessing;
    private bool _isJustDropped; // Переменная для контроля анимации падения

    protected override void OnInitialized()
    {
        _model.InitGrid();
    }

    private void MixBoard()
    {
        _model.InitGrid();
        _isJustDropped = true; // При перемешивании пусть красиво упадут сверху
        StateHasChanged();
    }

    private async Task OnTileClick(int row, int col)
    {
        if (_isProcessing) return;

        _isJustDropped = false; // Отключаем падение сверху при обычном клике/выделении

        if (_selectedRow == null || _selectedCol == null)
        {
            _selectedRow = row;
            _selectedCol = col;
            StateHasChanged();
        }
        else
        {
            var p1 = new TilePosition(_selectedRow.Value, _selectedCol.Value);
            var p2 = new TilePosition(row, col);

            _selectedRow = null;
            _selectedCol = null;

            if (_model.IsAdjacent(p1, p2))
            {
                _isProcessing = true;
                
                // 1. Поменяли местами
                _model.Swap(p1, p2);
                StateHasChanged();
                await Task.Delay(200);
                
                var matches = _model.CheckMatches();

                if (matches.Count > 0)
                {
                    while (matches.Count > 0)
                    {
                        // 2. Взорвали совпадения
                        _model.RemoveMatches(matches);
                        StateHasChanged();
                        await Task.Delay(250);

                        // 3. Сдвинули старые и насыпали новые
                        _isJustDropped = true; // Включаем эффект падения только для этого момента!
                        _model.DropTiles();
                        StateHasChanged();
                        await Task.Delay(250);
                        
                        _isJustDropped = false; // Выключаем обратно
                        matches = _model.CheckMatches();
                    }
                }
                else
                {
                    // Если совпадений нет — возвращаем плавно назад без мигания
                    _model.Swap(p1, p2);
                    StateHasChanged();
                }
                _isProcessing = false;
            }
            else
            {
                // Если кликнули на другую фишку, просто переключаем выделение
                _selectedRow = row;
                _selectedCol = col;
                StateHasChanged();
            }
        }
    }

    private string GetTileEmoji(int type) => type switch
    {
        1 => "🔴",
        2 => "🔵",
        3 => "🟢",
        4 => "🟡",
        5 => "🟣",
        _ => ""
    };
}
