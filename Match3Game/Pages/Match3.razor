@page "/match3"
@using System
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="game-wrapper">
    <div class="game-stats">
        <div class="stat-item">🏆 Счет: <span>@score</span></div>
        <div class="stat-item @(movesLeft <= 5 ? "low-moves" : "")">🎯 Ходы: <span>@movesLeft</span></div>
    </div>

    @if (isGameOver)
    {
        <div class="game-over-overlay">
            <h2>Игра окончена!</h2>
            <p>Ваш итоговый результат: <strong>@score</strong></p>
            <button class="action-btn restart-btn" @onclick="InitGame">Играть снова</button>
            <button class="action-btn exit-btn" @onclick="ExitToMenu">В меню</button>
        </div>
    }

    <div class="grid-container">
        @for (int r = 0; r < rows; r++)
        {
            @for (int c = 0; c < cols; c++)
            {
                var row = r;
                var col = c;
                var tileId = grid[row, col];
                var isSelected = (selectedRow == row && selectedCol == col);
                
                <div class="grid-cell" @onclick="() => OnCellClick(row, col)">
                    @if (tileId > 0)
                    {
                        <div class="tile-content @(isSelected ? "selected" : "")">
                            @GetTileEmoji(tileId)
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="control-panel">
        <button class="action-btn shuffle-btn" @onclick="ShuffleGrid" disabled="@isGameOver">
            🔀 Перемешать
        </button>
        <button class="action-btn back-menu-btn" @onclick="ExitToMenu">
            🚪 Выйти в меню
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnGameOver { get; set; }

    private int rows = 8;
    private int cols = 8;
    private int[,] grid = new int[8, 8];
    
    private int selectedRow = -1;
    private int selectedCol = -1;
    
    private int score = 0;
    private int movesLeft = 20;
    private bool isGameOver = false;
    private Random rand = new Random();

    protected override void OnInitialized()
    {
        InitGame();
    }

    private void InitGame()
    {
        score = 0;
        movesLeft = 20;
        isGameOver = false;
        ResetSelection();
        GenerateValidGrid();
    }

    private void ResetSelection()
    {
        selectedRow = -1;
        selectedCol = -1;
    }

    private void GenerateValidGrid()
    {
        do
        {
            for (int r = 0; r < rows; r++)
            {
                for (int c = 0; c < cols; c++)
                {
                    grid[r, c] = rand.Next(1, 6);
                }
            }
        } while (HasMatches());
    }

    private async Task OnCellClick(int r, int c)
    {
        if (isGameOver) return;

        if (selectedRow == -1 && selectedCol == -1)
        {
            selectedRow = r;
            selectedCol = c;
        }
        else
        {
            if (IsAdjacent(selectedRow, selectedCol, r, c))
            {
                SwapTiles(selectedRow, selectedCol, r, c);
                
                if (HasMatches())
                {
                    movesLeft--;
                    await ProcessMatches();
                    
                    if (movesLeft <= 0)
                    {
                        isGameOver = true;
                    }
                }
                else
                {
                    SwapTiles(selectedRow, selectedCol, r, c);
                }
            }
            ResetSelection();
        }
    }

    private bool IsAdjacent(int r1, int c1, int r2, int c2)
    {
        return (Math.Abs(r1 - r2) == 1 && c1 == c2) ||
               (Math.Abs(c1 - c2) == 1 && r1 == r2);
    }

    private void SwapTiles(int r1, int c1, int r2, int c2)
    {
        int temp = grid[r1, c1];
        grid[r1, c1] = grid[r2, c2];
        grid[r2, c2] = temp;
    }

    private bool HasMatches()
    {
        for (int r = 0; r < rows; r++)
        {
            for (int c = 0; c < cols - 2; c++)
            {
                if (grid[r, c] != 0 && grid[r, c] == grid[r, c + 1] && grid[r, c] == grid[r, c + 2])
                    return true;
            }
        }
        for (int c = 0; c < cols; c++)
        {
            for (int r = 0; r < rows - 2; r++)
            {
                if (grid[r, c] != 0 && grid[r, c] == grid[r + 1, c] && grid[r, c] == grid[r + 2, c])
                    return true;
            }
        }
        return false;
    }

    private async Task ProcessMatches()
    {
        while (HasMatches())
        {
            bool[,] toDestroy = new bool[rows, cols];

            for (int r = 0; r < rows; r++)
            {
                for (int c = 0; c < cols - 2; c++)
                {
                    if (grid[r, c] != 0 && grid[r, c] == grid[r, c + 1] && grid[r, c] == grid[r, c + 2])
                    {
                        toDestroy[r, c] = toDestroy[r, c + 1] = toDestroy[r, c + 2] = true;
                    }
                }
            }

            for (int c = 0; c < cols; c++)
            {
                for (int r = 0; r < rows - 2; r++)
                {
                    if (grid[r, c] != 0 && grid[r, c] == grid[r + 1, c] && grid[r, c] == grid[r + 2, c])
                    {
                        toDestroy[r, c] = toDestroy[r + 1, c] = toDestroy[r + 2, c] = true;
                    }
                }
            }

            int destroyedCount = 0;
            for (int r = 0; r < rows; r++)
            {
                for (int c = 0; c < cols; c++)
                {
                    if (toDestroy[r, c])
                    {
                        grid[r, c] = 0;
                        destroyedCount++;
                    }
                }
            }

            score += destroyedCount * 10;
            StateHasChanged();
            await Task.Delay(250);

            DropAndFill();
            StateHasChanged();
            await Task.Delay(200);
        }
    }

    private void DropAndFill()
    {
        for (int c = 0; c < cols; c++)
        {
            int emptyRow = rows - 1;
            for (int r = rows - 1; r >= 0; r--)
            {
                if (grid[r, c] != 0)
                {
                    grid[emptyRow, c] = grid[r, c];
                    if (emptyRow != r) grid[r, c] = 0;
                    emptyRow--;
                }
            }

            for (int r = emptyRow; r >= 0; r--)
            {
                grid[r, c] = rand.Next(1, 6);
            }
        }
    }

    private void ShuffleGrid()
    {
        if (isGameOver) return;
        GenerateValidGrid();
        ResetSelection();
    }

    private async Task ExitToMenu()
    {
        await OnGameOver.InvokeAsync();
    }

    private string GetTileEmoji(int id)
    {
        return id switch
        {
            1 => "💎",
            2 => "🔷",
            3 => "💚",
            4 => "🔶",
            5 => "🔮",
            _ => ""
        };
    }
}

<style>
    .game-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
        padding: 10px;
        position: relative;
    }
    .game-stats {
        display: flex;
        justify-content: space-between;
        width: 100%;
        margin-bottom: 15px;
    }
    .stat-item {
        background: #2c3e50;
        padding: 8px 15px;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: bold;
        border: 1px solid #34495e;
    }
    .low-moves {
        color: #e74c3c;
        border-color: #e74c3c;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        grid-template-rows: repeat(8, 1fr);
        gap: 4px;
        background-color: #2c3e50;
        padding: 6px;
        border-radius: 12px;
        width: 100%;
        aspect-ratio: 1 / 1;
        box-shadow: 0 8px 20px rgba(0,0,0,0.5);
        box-sizing: border-box;
    }
    .grid-cell {
        background-color: #34495e;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        user-select: none;
        position: relative;
        aspect-ratio: 1 / 1;
    }
    .tile-content {
        font-size: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        transition: transform 0.1s ease;
    }
    .tile-content.selected {
        transform: scale(0.85);
        border: 2px solid #f1c40f;
        border-radius: 6px;
        background-color: rgba(241, 196, 15, 0.2);
    }
    .control-panel {
        display: flex;
        gap: 10px;
        width: 100%;
        margin-top: 15px;
    }
    .action-btn {
        flex: 1;
        padding: 12px;
        font-size: 1rem;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        color: white;
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    }
    .shuffle-btn { background-color: #e67e22; }
    .back-menu-btn { background-color: #95a5a6; }

    .game-over-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(44, 62, 80, 0.95);
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: white;
        text-align: center;
        padding: 20px;
        box-sizing: border-box;
    }
    .game-over-overlay h2 { color: #e74c3c; margin-bottom: 10px; }
    .restart-btn { background-color: #2ecc71; margin-bottom: 10px; width: 200px; }
