@page "/"

<div class="game-container">
    @if (_gameState == GameState.Menu)
    {
        <!-- СТАРТОВОЕ МЕНЮ -->
        <div class="menu-screen">
            <h1 class="menu-title">💥 MATCH-3 💥</h1>
            <p class="menu-desc">Собери как можно больше комбинаций!<br>У тебя есть ровно 25 ходов.</p>
            <button class="start-btn" @onclick="StartNewGame">Начать игру</button>
        </div>
    }
    else if (_gameState == GameState.Playing)
    {
        <!-- ИГРОВОЙ ПРОЦЕСС -->
        <div class="game-header">
            <div class="stat-box">Очки: <span class="stat-value">@_score</span></div>
            <div class="stat-box">Ходы: <span class="stat-value">@_movesLeft</span></div>
        </div>
        
        <button class="test-btn" @onclick="MixBoard">Перемешать поле</button>

        <div class="game-board" style="grid-template-rows: repeat(8, 1fr); grid-template-columns: repeat(8, 1fr);">
            @for (int r = 0; r < 8; r++)
            {
                for (int c = 0; c < 8; c++)
                {
                    int row = r;
                    int col = c;
                    int tileType = _grid[row, col];
                    bool isSelected = _selectedRow == row && _selectedCol == col;

                    <div @key="@($"tile-{row}-{col}")" 
                         class="tile @(isSelected ? "selected" : "")" 
                         @onclick="() => OnTileClick(row, col)">
                        <span class="tile-content">@GetTileEmoji(tileType)</span>
                    </div>
                }
            }
        </div>
    }
    else if (_gameState == GameState.GameOver)
    {
        <!-- ЭКРАН ОКОНЧАНИЯ ИГРЫ -->
        <div class="gameover-screen">
            <h2 class="gameover-title">Ходы закончились!</h2>
            <p class="gameover-score">Финальный счёт: <span>@_score</span></p>
            <button class="start-btn" @onclick="GoToMenu">В меню</button>
        </div>
    }
</div>

@code {
    private enum GameState { Menu, Playing, GameOver }
    private GameState _gameState = GameState.Menu;

    private int[,] _grid = new int[8, 8];
    private int _score = 0;
    private int _movesLeft = 25;
    
    private int? _selectedRow;
    private int? _selectedCol;
    private bool _isProcessing;
    private readonly Random _rand = new();

    private void StartNewGame()
    {
        InitGrid();
        _score = 0;
        _movesLeft = 25;
        _selectedRow = null;
        _selectedCol = null;
        _isProcessing = false;
        _gameState = GameState.Playing;
        StateHasChanged();
    }

    private void GoToMenu()
    {
        _gameState = GameState.Menu;
        StateHasChanged();
    }

    private void MixBoard()
    {
        if (_gameState != GameState.Playing) return;
        InitGrid();
        StateHasChanged();
    }

    private void InitGrid()
    {
        do
        {
            for (int r = 0; r < 8; r++)
            {
                for (int c = 0; c < 8; c++)
                {
                    _grid[r, c] = _rand.Next(1, 6);
                }
            }
        } while (FindMatches().Count > 0);
    }

    private async Task OnTileClick(int row, int col)
    {
        if (_isProcessing || _gameState != GameState.Playing) return;

        if (_selectedRow == null || _selectedCol == null)
        {
            _selectedRow = row;
            _selectedCol = col;
            StateHasChanged();
        }
        else
        {
            int r1 = _selectedRow.Value;
            int c1 = _selectedCol.Value;
            
            _selectedRow = null;
            _selectedCol = null;

            if ((Math.Abs(r1 - row) == 1 && c1 == col) || (Math.Abs(c1 - col) == 1 && r1 == row))
            {
                _isProcessing = true;
                Swap(r1, c1, row, col);
                StateHasChanged();
                await Task.Delay(250);
                
                var matches = FindMatches();

                if (matches.Count > 0)
                {
                    _movesLeft--;

                    while (matches.Count > 0)
                    {
                        _score += matches.Count * 10;
                        foreach (var pos in matches)
                        {
                            _grid[pos.R, pos.C] = 0;
                        }
                        StateHasChanged();
                        await Task.Delay(250);

                        DropTiles();
                        StateHasChanged();
                        await Task.Delay(250);

                        matches = FindMatches();
                    }

                    if (_movesLeft <= 0)
                    {
                        _gameState = GameState.GameOver;
                    }
                }
                else
                {
                    Swap(r1, c1, row, col);
                    StateHasChanged();
                }
                _isProcessing = false;
            }
            else
            {
                _selectedRow = row;
                _selectedCol = col;
                StateHasChanged();
            }
        }
    }

    private void Swap(int r1, int c1, int r2, int c2)
    {
        int temp = _grid[r1, c1];
        _grid[r1, c1] = _grid[r2, c2];
        _grid[r2, c2] = temp;
    }

    private List<(int R, int C)> FindMatches()
    {
        var matches = new HashSet<(int R, int C)>();

        for (int r = 0; r < 8; r++)
        {
            for (int c = 0; c < 6; c++)
            {
                int val = _grid[r, c];
                if (val != 0 && _grid[r, c + 1] == val && _grid[r, c + 2] == val)
                {
                    matches.Add((r, c));
                    matches.Add((r, c + 1));
                    matches.Add((r, c + 2));
                }
            }
        }

        for (int c = 0; c < 8; c++)
        {
            for (int r = 0; r < 6; r++)
            {
                int val = _grid[r, c];
                if (val != 0 && _grid[r + 1, c] == val && _grid[r + 2, c] == val)
                {
                    matches.Add((r, c));
                    matches.Add((r + 1, c));
                    matches.Add((r + 2, c));
                }
            }
        }

        return matches.ToList();
    }

    private void DropTiles()
    {
        for (int c = 0; c < 8; c++)
        {
            int emptyRow = 7;
            for (int r = 7; r >= 0; r--)
            {
                if (_grid[r, c] != 0)
                {
                    if (emptyRow != r)
                    {
                        _grid[emptyRow, c] = _grid[r, c];
                        _grid[r, c] = 0;
                    }
                    emptyRow--;
                }
            }
            for (int r = emptyRow; r >= 0; r--)
            {
                _grid[r, c] = _rand.Next(1, 6);
            }
        }
    }

    private string GetTileEmoji(int type) => type switch
    {
        1 => "🔴", 2 => "🔵", 3 => "🟢", 4 => "🟡", 5 => "🟣", _ => ""
    };
}
