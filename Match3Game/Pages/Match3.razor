@page "/"
@using Match3Game.Core

<div class="game-container">
    @if (_gameState == GameState.Menu)
    {
        <!-- Вызываем изолированное меню и передаем ему параметры -->
        <GameMenu MaxMoves="25" OnStartGame="StartNewGame" />
    }
    else if (_gameState == GameState.Playing)
    {
        <!-- ИГРОВОЙ ПРОЦЕСС -->
        <div class="game-header">
            <div class="stat-box">Очки: <span class="stat-value">@_model.Score</span></div>
            <div class="stat-box">Ходы: <span class="stat-value">@_movesLeft</span></div>
        </div>
        
        <button class="test-btn" @onclick="MixBoard">Перемешать поле</button>

        <div class="game-board" style="grid-template-rows: repeat(@GameConfig.Rows, 1fr); grid-template-columns: repeat(@GameConfig.Cols, 1fr);">
            @for (int r = 0; r < GameConfig.Rows; r++)
            {
                for (int c = 0; c < GameConfig.Cols; c++)
                {
                    int row = r;
                    int col = c;
                    int tileType = _model.Grid[row, col];
                    bool isSelected = _selectedRow == row && _selectedCol == col;

                    <div @key="@($"tile-{row}-{col}")" 
                         class="tile @(isSelected ? "selected" : "")" 
                         @onclick="() => OnTileClick(row, col)">
                        <span class="tile-content">@GetTileEmoji(tileType)</span>
                    </div>
                }
            }
        </div>
    }
    else if (_gameState == GameState.GameOver)
    {
        <!-- ЭКРАН ОКОНЧАНИЯ ИГРЫ -->
        <div class="gameover-screen">
            <h2 class="gameover-title">Ходы закончились!</h2>
            <p class="gameover-score">Финальный счёт: <span>@_model.Score</span></p>
            <button class="start-btn" @onclick="GoToMenu">В меню</button>
        </div>
    }
</div>

@code {
    private enum GameState { Menu, Playing, GameOver }
    private GameState _gameState = GameState.Menu;

    private GameModel _model = new();
    private int? _selectedRow;
    private int? _selectedCol;
    private bool _isProcessing;
    private int _movesLeft = 25;

    private void StartNewGame()
    {
        _model.InitGrid();
        _movesLeft = 25;
        _selectedRow = null;
        _selectedCol = null;
        _isProcessing = false;
        _gameState = GameState.Playing;
        StateHasChanged();
    }

    private void GoToMenu()
    {
        _gameState = GameState.Menu;
        StateHasChanged();
    }

    private void MixBoard()
    {
        if (_gameState != GameState.Playing) return;
        _model.InitGrid();
        StateHasChanged();
    }

    private async Task OnTileClick(int row, int col)
    {
        if (_isProcessing || _gameState != GameState.Playing) return;

        if (_selectedRow == null || _selectedCol == null)
        {
            _selectedRow = row;
            _selectedCol = col;
            StateHasChanged();
        }
        else
        {
            var p1 = new TilePosition(_selectedRow.Value, _selectedCol.Value);
            var p2 = new TilePosition(row, col);

            _selectedRow = null;
            _selectedCol = null;

            if (_model.IsAdjacent(p1, p2))
            {
                _isProcessing = true;
                _model.Swap(p1, p2);
                StateHasChanged();
                await Task.Delay(250);
                
                var matches = _model.CheckMatches();

                if (matches.Count > 0)
                {
                    _movesLeft--;

                    while (matches.Count > 0)
                    {
                        _model.RemoveMatches(matches);
                        StateHasChanged();
                        await Task.Delay(250);

                        _model.DropTiles();
                        StateHasChanged();
                        await Task.Delay(250);

                        matches = _model.CheckMatches();
                    }

                    if (_movesLeft <= 0)
                    {
                        _gameState = GameState.GameOver;
                    }
                }
                else
                {
                    _model.Swap(p1, p2);
                    StateHasChanged();
                }
                _isProcessing = false;
            }
            else
            {
                _selectedRow = row;
                _selectedCol = col;
                StateHasChanged();
            }
        }
    }

    private string GetTileEmoji(int type) => type switch
    {
        1 => "🔴", 2 => "🔵", 3 => "🟢", 4 => "🟡", 5 => "🟣", _ => ""
    };
}
