<div style="display: flex; flex-direction: column; align-items: center; padding: 10px;">
    <h1 style="color: #fff; font-size: 1.6rem; margin-bottom: 25px; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">👤 Регистрация</h1>
    <div style="background: #2c3e50; border: 2px solid #34495e; border-radius: 12px; padding: 20px; width: 100%; max-width: 300px; display: flex; flex-direction: column; gap: 15px;">
        <div style="display: flex; flex-direction: column; gap: 5px;">
            <label style="font-size: 0.9rem; color: #f1c40f; font-weight: bold;">Имя игрока:</label>
            <input type="text" @value="Name" @onchange="(e) => OnNameChanged.InvokeAsync(e.Value?.ToString())" placeholder="Придумайте имя..." maxlength="20" style="padding: 10px; border-radius: 6px; border: 1px solid #4a6572; background: #1a1a1a; color: white;" />
        </div>
        <div style="display: flex; flex-direction: column; gap: 5px;">
            <label style="font-size: 0.9rem; color: #f1c40f; font-weight: bold;">Криптокошелек Грам:</label>
            <input type="text" @value="Wallet" @onchange="(e) => OnWalletChanged.InvokeAsync(e.Value?.ToString())" placeholder="Адрес кошелька..." style="padding: 10px; border-radius: 6px; border: 1px solid #4a6572; background: #1a1a1a; color: white;" />
        </div>
        <button style="background: #2ecc71; color: white; padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px; cursor: pointer;" @onclick="OnSave">💾 Сохранить аккаунт</button>
    </div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Wallet { get; set; } = "";
    [Parameter] public EventCallback<string> OnNameChanged { get; set; }
    [Parameter] public EventCallback<string> OnWalletChanged { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
