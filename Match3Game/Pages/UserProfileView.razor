<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Abhiramburg Match3 Game</title>
    <base href="/abhiramburg/" />
    <link href="css/match3.css" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;,">
    <style>
        html, body {
            margin: 0; padding: 0; background-color: #1a1a1a;
            font-family: 'Segoe UI', sans-serif; color: white;
            min-height: 100vh; display: flex; flex-direction: column;
        }
        #blazor-error-ui { display: none !important; }
    </style>
</head>
<body>
    <div id="app">
        <div style="display: flex; min-height: 100vh; justify-content: center; align-items: center; color: white;">
            <h2>Загрузка города...</h2>
        </div>
    </div>

    <script src="_framework/blazor.webassembly.js"></script>
    
    <!-- Официальный скрипт авторизации Google -->
    <script src="https://google.com" async defer></script>

    <script>
        window.googleUserData = null;

        // Функция обратного вызова при успешном входе через Google
        function handleCredentialResponse(response) {
            try {
                // Декодируем JWT-токен, который прислал Google, чтобы достать имя пользователя
                const base64Url = response.credential.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(window.atatob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));

                const user = JSON.parse(jsonPayload);
                window.googleUserData = {
                    name: user.name,
                    email: user.email,
                    id: user.sub
                };

                console.log("Успешный вход Google:", window.googleUserData.name);
            } catch (e) {
                console.error("Ошибка декодирования профиля Google:", e);
            }
        }

        window.initGoogleAuth = function () {
            if (!window.google || !window.google.accounts) return "Библиотека Google еще загружается...";
            
            try {
                // Инициализируем клиент Google (используем тестовый Client ID)
                google.accounts.id.initialize({
                    client_id: "://googleusercontent.com",
                    callback: handleCredentialResponse
                });

                // Отрисовываем красивую стандартную кнопку Google в специальный контейнер
                const btnContainer = document.getElementById("google-button-container");
                if (btnContainer) {
                    google.accounts.id.renderButton(
                        btnContainer,
                        { theme: "filled_blue", size: "large", width: 260 }
                    );
                }
                return "Google Init Success";
            } catch (e) {
                return "Ошибка Google Init: " + e.message;
            }
        };

        window.getGoogleUser = function () {
            return window.googleUserData ? JSON.stringify(window.googleUserData) : "";
        };

        window.logoutGoogleUser = function () {
            window.googleUserData = null;
            if (window.google && window.google.accounts) {
                google.accounts.id.disableAutoSelect();
            }
            return "Logged Out";
        };

        // Заглушка функции atob для безопасной обработки спецсимволов кириллицы
        window.atatob = function(str) {
            return decodeURIComponent(Array.prototype.map.call(window.atob(str), function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
        };
    </script>
</body>
</html>
