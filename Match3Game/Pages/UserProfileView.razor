@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Match3Game.Core
@inject IJSRuntime JS

<div style="display: flex; flex-direction: column; align-items: center; padding: 10px;">
    <h1 style="color: #fff; font-size: 1.6rem; margin-bottom: 25px; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">👤 Профиль игрока</h1>
    <div style="background: #2c3e50; border: 2px solid #34495e; border-radius: 12px; padding: 20px; width: 100%; max-width: 300px; display: flex; flex-direction: column; gap: 15px; color: white;">
        
        <div style="display: flex; flex-direction: column; gap: 5px;">
            <label style="font-size: 0.9rem; color: #f1c40f; font-weight: bold;">Имя в игре:</label>
            <input type="text" @bind="localName" placeholder="Введите ваше имя..." maxlength="20" style="padding: 10px; border-radius: 6px; border: 1px solid #4a6572; background: #1a1a1a; color: white;" />
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #34495e; padding-top: 15px; margin-top: 5px;">
            <label style="font-size: 0.9rem; color: #bdc3c7; font-weight: bold;">Криптокошелек Gram (TON):</label>
            
            @if (string.IsNullOrEmpty(WalletAddress))
            {
                <button type="button" style="background: #3498db; color: white; padding: 12px; font-weight: bold; border: none; border-radius: 8px; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 100%;" @onclick="ConnectViaTon">
                    💎 Подключить кошелек TON
                </button>
            }
            else
            {
                <div style="background: rgba(39, 174, 96, 0.15); border: 1px solid #27ae60; padding: 12px; border-radius: 8px; font-size: 0.85rem; text-align: left; word-break: break-all;">
                    <span style="color: #2ecc71; font-weight: bold; display: block; margin-bottom: 4px;">✅ Подключено:</span>
                    <code style="color: #fff;">@WalletAddress</code>
                </div>
                <button type="button" style="background: #c0392b; color: white; padding: 8px; font-size: 0.8rem; font-weight: bold; border: none; border-radius: 6px; cursor: pointer; margin-top: 5px; width: 100%;" @onclick="DisconnectTon">
                    ❌ Отключить кошелек
                </button>
            }
        </div>
        
        <button type="button" style="background: #2ecc71; color: white; padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px; cursor: pointer; margin-top: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.2); width: 100%;" @onclick="SubmitSave">💾 Сохранить изменения</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(localAlert))
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 10000;">
        <div style="background: #2c3e50; color: white; padding: 25px 40px; border-radius: 15px; text-align: center; border: 2px solid #f1c40f;">
            <p style="font-size: 1.1rem; margin: 0 0 20px 0; font-weight: bold;">@localAlert</p>
            <button type="button" style="background: #f1c40f; color: #2c3e50; border: none; padding: 8px 25px; font-weight: bold; border-radius: 5px; cursor: pointer;" @onclick="() => localAlert = null">OK</button>
        </div>
    </div>
}

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string WalletAddress { get; set; } = "";
    [Parameter] public EventCallback<(string, string)> OnProfileSaved { get; set; }

    private string localName = "";
    private string? localAlert;

    protected override void OnParametersSet()
    {
        localName = Name;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initTonConnect");
            await CheckWalletStatus();
        }
    }

    private async Task ConnectViaTon()
    {
        // Вызываем JS-метод и выводим alert, если браузер заблокирует окно
        var res = await JS.InvokeAsync<string>("openTonConnectModal");
        if (res != "Modal Opened")
        {
            localAlert = "Статус вызова: " + res;
        }
        await Task.Delay(1000);
        await CheckWalletStatus();
    }

    private async Task DisconnectTon()
    {
        await JS.InvokeVoidAsync("disconnectTonWallet");
        await CheckWalletStatus();
    }

    private async Task CheckWalletStatus()
    {
        var currentAddr = await JS.InvokeAsync<string>("getTonWalletAddress");
        if (currentAddr != WalletAddress)
        {
            await OnProfileSaved.InvokeAsync((localName, currentAddr));
        }
    }

    private async Task SubmitSave()
    {
        if (string.IsNullOrWhiteSpace(localName)) { localAlert = "Пожалуйста, укажите имя!"; return; }
        
        var activeAddr = await JS.InvokeAsync<string>("getTonWalletAddress");
        if (string.IsNullOrEmpty(activeAddr)) { localAlert = "Сначала необходимо подключить TON кошелек!"; return; }
        
        await OnProfileSaved.InvokeAsync((localName.Trim(), activeAddr));
    }
}
