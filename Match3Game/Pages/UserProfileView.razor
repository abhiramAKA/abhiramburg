<div style="display: flex; flex-direction: column; align-items: center; padding: 10px;">
    <h1 style="color: #fff; font-size: 1.6rem; margin-bottom: 25px; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">👤 Профиль игрока</h1>
    <div style="background: #2c3e50; border: 2px solid #34495e; border-radius: 12px; padding: 20px; width: 100%; max-width: 300px; display: flex; flex-direction: column; gap: 15px; color: white;">
        
        <div style="display: flex; flex-direction: column; gap: 5px;">
            <label style="font-size: 0.9rem; color: #f1c40f; font-weight: bold;">Имя в игре:</label>
            <input type="text" @value="Name" @onchange="(e) => OnNameChanged.InvokeAsync(e.Value?.ToString())" placeholder="Введите ваше имя..." maxlength="20" style="padding: 10px; border-radius: 6px; border: 1px solid #4a6572; background: #1a1a1a; color: white;" />
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #34495e; padding-top: 15px; margin-top: 5px;">
            <label style="font-size: 0.9rem; color: #bdc3c7; font-weight: bold;">Криптокошелек Gram (TON):</label>
            
            @if (string.IsNullOrEmpty(WalletAddress))
            {
                <button style="background: #3498db; color: white; padding: 12px; font-weight: bold; border: none; border-radius: 8px; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.1);" @onclick="OnConnect">
                    💎 Подключить кошелек TON
                </button>
            }
            else
            {
                <div style="background: rgba(39, 174, 96, 0.15); border: 1px solid #27ae60; padding: 12px; border-radius: 8px; font-size: 0.85rem; text-align: left; word-break: break-all;">
                    <span style="color: #2ecc71; font-weight: bold; display: block; margin-bottom: 4px;">✅ Подключено:</span>
                    <code style="color: #fff;">@WalletAddress</code>
                </div>
                <button style="background: #c0392b; color: white; padding: 8px; font-size: 0.8rem; font-weight: bold; border: none; border-radius: 6px; cursor: pointer; margin-top: 5px;" @onclick="OnDisconnect">
                    ❌ Отключить кошелек
                </button>
            }
        </div>
        
        <button style="background: #2ecc71; color: white; padding: 14px 20px; font-weight: bold; border: none; border-radius: 10px; cursor: pointer; margin-top: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.2);" @onclick="OnSave">💾 Сохранить изменения</button>
    </div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string WalletAddress { get; set; } = "";
    [Parameter] public EventCallback<string> OnNameChanged { get; set; }
    [Parameter] public EventCallback OnConnect { get; set; }
    [Parameter] public EventCallback OnDisconnect { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
